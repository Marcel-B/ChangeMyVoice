{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Storage": {
    "DataRoot": "",
    "MaxUploadBytes": 209715200
  },

  "Persistence": {
    "DatabasePath": ""
  },

  "Inference": {
    "PythonExecutable": "",
    "ScriptPath": "",
    "WorkingDirectory": "",
    "SeedVcPath": "",
    "HuggingFaceCachePath": "",
    "Backend": "seed-vc",
    "Timeout": "02:00:00"
  },

  "AudioTooling": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "Timeout": "00:05:00"
  },

  "Worker": {
    "QueueCapacity": 64,
    "MaxConcurrentInference": 1,
    "CleanupInterval": "00:15:00"
  },

  "Security": {
    "Clients": [],
    "AllowedClientAddresses": []
  }
}
