# Vorlage für die .env-Datei des Gateways auf dem Proxmox-Host.
# Kopieren nach .env und ausfüllen — die .env selbst gehört nicht ins Repository.

# Wem das Abbild in der GitHub-Registry gehört.
GITHUB_OWNER=b-velop

# Die Mac-API. Die Adresse muss die sein, unter der Kestrel dort lauscht.
CHANGEMYVOICE_UPSTREAM=http://10.0.0.5:5080

# Der Zugangsschlüssel der Mac-API im Klartext. Er verlässt den Proxmox-Host
# nicht und wird vom Gateway beim Weiterleiten gesetzt.
CHANGEMYVOICE_UPSTREAM_KEY=

# Ein Aufrufer des Gateways. Hinterlegt wird nur der Streuwert:
#   printf '%s' 'client-schluessel' | shasum -a 256 | cut -d' ' -f1
CHANGEMYVOICE_CLIENT_NAME=studio-app
CHANGEMYVOICE_CLIENT_HASH=
