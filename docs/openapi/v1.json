{
  "components": {
    "schemas": {
      "AudioPropertiesResponse": {
        "description": "Die Eigenschaften einer Audioaufnahme.",
        "properties": {
          "channels": {
            "description": "Die Anzahl der Kanäle.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "codec": {
            "description": "Der Codec, etwa `pcm_s16le` oder `mp3`.",
            "type": "string"
          },
          "durationSeconds": {
            "description": "Die Spieldauer in Sekunden.",
            "format": "double",
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ]
          },
          "sampleRate": {
            "description": "Die Abtastrate in Hertz.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "codec",
          "durationSeconds",
          "sampleRate",
          "channels"
        ],
        "type": "object"
      },
      "HealthCheckResponse": {
        "description": "Eine einzelne Bereitschaftsprüfung.",
        "properties": {
          "detail": {
            "description": "Eine knappe Erläuterung, falls nicht.",
            "type": [
              "null",
              "string"
            ]
          },
          "healthy": {
            "description": "Ob sie bestanden wurde.",
            "type": "boolean"
          },
          "name": {
            "description": "Der Name der Prüfung.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "healthy",
          "detail"
        ],
        "type": "object"
      },
      "HealthResponse": {
        "description": "Der Zustand des Dienstes.",
        "properties": {
          "checks": {
            "description": "Die einzelnen Prüfungen.",
            "items": {
              "$ref": "#/components/schemas/HealthCheckResponse"
            },
            "type": "array"
          },
          "status": {
            "description": "\"healthy\" oder \"unhealthy\".",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "type": "object"
      },
      "IFormFile": {
        "format": "binary",
        "type": "string"
      },
      "IResult": {
        "type": "object"
      },
      "JobErrorResponse": {
        "description": "Die Fehlerursache eines Auftrags.",
        "properties": {
          "code": {
            "description": "Der Fehlercode.",
            "type": "string"
          },
          "message": {
            "description": "Eine kurze Begründung.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "JobListResponse": {
        "description": "Ein Ausschnitt aus der Auftragsliste.",
        "properties": {
          "items": {
            "description": "Die Aufträge dieser Seite, die jüngsten zuerst.",
            "items": {
              "$ref": "#/components/schemas/JobResponse"
            },
            "type": "array"
          },
          "limit": {
            "description": "Die verwendete Seitengröße.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "offset": {
            "description": "Der verwendete Versatz.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          },
          "total": {
            "description": "Wie viele Aufträge insgesamt zum Filter passen.",
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ]
          }
        },
        "required": [
          "items",
          "total",
          "limit",
          "offset"
        ],
        "type": "object"
      },
      "JobResponse": {
        "description": "Der Zustand eines Konvertierungsauftrags.",
        "properties": {
          "createdAtUtc": {
            "description": "Zeitpunkt der Annahme.",
            "format": "date-time",
            "type": "string"
          },
          "error": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/JobErrorResponse",
                "description": "Die Ursache, falls der Auftrag fehlgeschlagen ist."
              }
            ]
          },
          "estimatedDurationSeconds": {
            "description": "Voraussichtliche Rechenzeit in Sekunden. Eine Orientierung, keine Zusage —\ngedacht für eine Fortschrittsanzeige, denn ein Lauf kann je nach Länge des\nMaterials deutlich über eine Stunde dauern.",
            "format": "double",
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ]
          },
          "finishedAtUtc": {
            "description": "Zeitpunkt des Endes.",
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          },
          "jobId": {
            "description": "Die Kennung.",
            "type": "string"
          },
          "resultSha256": {
            "description": "Die Prüfsumme der Ergebnisdatei, damit ein abgebrochener Abruf erkennbar ist.",
            "type": [
              "null",
              "string"
            ]
          },
          "resultSizeBytes": {
            "description": "Die Größe der Ergebnisdatei.",
            "format": "int64",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "resultUrl": {
            "description": "Wo das Ergebnis abgeholt werden kann, sobald es bereitsteht.",
            "type": [
              "null",
              "string"
            ]
          },
          "sourceLengthSeconds": {
            "description": "Die Länge der Quellaufnahme in Sekunden.",
            "format": "double",
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ]
          },
          "startedAtUtc": {
            "description": "Zeitpunkt des Beginns.",
            "format": "date-time",
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "description": "Der Zustand: QUEUED, RUNNING, COMPLETED, FAILED oder CANCELLED.",
            "type": "string"
          },
          "voiceId": {
            "description": "Die verwendete Referenzstimme.",
            "type": "string"
          },
          "voiceLabel": {
            "description": "Deren Bezeichnung bei Annahme des Auftrags.",
            "type": "string"
          },
          "webhookUrl": {
            "description": "Die Adresse, die beim Ende des Auftrags aufgerufen wird, falls beim Anlegen\neine angegeben wurde.",
            "type": [
              "null",
              "string"
            ]
          }
        },
        "required": [
          "jobId",
          "status",
          "voiceId",
          "voiceLabel",
          "createdAtUtc",
          "startedAtUtc",
          "finishedAtUtc",
          "error",
          "resultUrl",
          "resultSizeBytes",
          "resultSha256",
          "sourceLengthSeconds",
          "estimatedDurationSeconds"
        ],
        "type": "object"
      },
      "ProblemDetails": {
        "properties": {
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "type": "object"
      },
      "ReferenceVoiceResponse": {
        "description": "Eine gespeicherte Referenzstimme.",
        "properties": {
          "createdAtUtc": {
            "description": "Zeitpunkt der Anlage.",
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "description": "Die Kennung, mit der sie bei einem Auftrag angegeben wird.",
            "type": "string"
          },
          "label": {
            "description": "Die Bezeichnung.",
            "type": "string"
          },
          "original": {
            "$ref": "#/components/schemas/AudioPropertiesResponse",
            "description": "Die Eigenschaften der hochgeladenen Datei. Daran ist erkennbar, ob das\nAusgangsmaterial für ein gutes Ergebnis taugt."
          },
          "stored": {
            "$ref": "#/components/schemas/AudioPropertiesResponse",
            "description": "Die Eigenschaften der abgelegten Datei — stets mono, PCM und 44,1 kHz."
          }
        },
        "required": [
          "id",
          "label",
          "createdAtUtc",
          "stored",
          "original"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "ApiKey": {
        "description": "Der Zugangsschlüssel. Anfragen werden ausschließlich über das Gateway angenommen, das diesen Schlüssel setzt.",
        "in": "header",
        "name": "X-Api-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Schnittstelle für Singing Voice Conversion: Eine Gesangsaufnahme behält ihre Melodie, Phrasierung und Darbietung, übernimmt aber das Timbre einer gespeicherten Referenzstimme. Die Verarbeitung läuft im Hintergrund — ein Auftrag wird angenommen, sein Fortschritt abgefragt und das Ergebnis anschließend heruntergeladen.",
    "title": "ChangeMyVoice",
    "version": "v1"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/v1/jobs": {
      "get": {
        "description": "Liefert eine Uebersicht der Auftraege, die juengsten zuerst. Gedacht fuer eine Verwaltungsoberflaeche.\n\nDie Antwort ist seitenweise, weil aufgeraeumte Auftraege als Datensatz erhalten bleiben und die Gesamtzahl damit dauerhaft waechst. Ueber 'limit' (1 bis 200, Standard 50) und 'offset' wird geblaettert; 'total' nennt die Gesamtzahl der passenden Auftraege. Mit 'status' laesst sich auf QUEUED, RUNNING, COMPLETED, FAILED oder CANCELLED einschraenken.",
        "operationId": "ListConversionJobs",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          },
          {
            "in": "query",
            "name": "offset",
            "schema": {
              "format": "int32",
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobListResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Der Zugangsschlüssel fehlt oder ist ungültig."
          },
          "403": {
            "description": "Die Anfrage kam nicht von einer zugelassenen Adresse."
          }
        },
        "security": [
          {}
        ],
        "summary": "Alle Auftraege anzeigen",
        "tags": [
          "ChangeMyVoice"
        ]
      },
      "post": {
        "description": "Nimmt die zu konvertierende Aufnahme entgegen und startet den Auftrag mit der angegebenen Referenzstimme. Die Antwort kommt sofort; der Fortschritt wird über den Status abgefragt. Die Gesangsdarbietung der Quelle bleibt erhalten, das Timbre stammt aus der Referenz.\n\nStandardmäßig läuft die Konvertierung im Gesangspfad: 44,1 kHz mit Tonhöhenkonditionierung, wodurch die Tonhöhe sauber übertragen wird. Das dauert länger — bei rund 15 Sekunden Material etwa 60 statt 40 Sekunden. Mit 'f0Condition=false' läuft stattdessen der schnellere Sprachpfad bei 22,05 kHz.\n\nMit 'webhookUrl' (absolute http- oder https-Adresse) ruft der Dienst diese Adresse per POST auf, sobald der Auftrag COMPLETED, FAILED oder CANCELLED ist, statt dass der Aufrufer alle paar Sekunden nachfragt. Der Rumpf ist JSON mit 'event' (\"job.finished\"), 'jobId', 'status', 'voiceId', 'finishedAtUtc', 'error', 'statusUrl', 'resultUrl', 'resultSizeBytes' und 'resultSha256'; der Kopf 'X-ChangeMyVoice-Event' nennt die Art. Antwortet der Empfänger nicht mit 2xx, wird bei Zeitablauf, 408, 429 und 5xx mit wachsendem Abstand wiederholt. Die Nachricht ist nicht signiert und nur ein Anstoß: Verbindlich bleibt der Status, den der Empfänger daraufhin abfragt.",
        "operationId": "SubmitConversionJob",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "allOf": [
                  {
                    "properties": {
                      "voiceId": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "source": {
                        "$ref": "#/components/schemas/IFormFile"
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "diffusionSteps": {
                        "format": "int32",
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                          "integer",
                          "string"
                        ]
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "inferenceCfgRate": {
                        "format": "double",
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "type": [
                          "number",
                          "string"
                        ]
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "lengthAdjust": {
                        "format": "double",
                        "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
                        "type": [
                          "number",
                          "string"
                        ]
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "f0Condition": {
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "fp16": {
                        "type": "boolean"
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "outputSampleRate": {
                        "format": "int32",
                        "pattern": "^-?(?:0|[1-9]\\d*)$",
                        "type": [
                          "integer",
                          "string"
                        ]
                      }
                    },
                    "type": "object"
                  },
                  {
                    "properties": {
                      "webhookUrl": {
                        "type": "string"
                      }
                    },
                    "type": "object"
                  }
                ],
                "required": [
                  "voiceId",
                  "source"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            },
            "description": "Accepted"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Der Zugangsschlüssel fehlt oder ist ungültig."
          },
          "403": {
            "description": "Die Anfrage kam nicht von einer zugelassenen Adresse."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          },
          "413": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Payload Too Large"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {}
        ],
        "summary": "Stimme zur Änderung senden",
        "tags": [
          "ChangeMyVoice"
        ]
      }
    },
    "/api/v1/jobs/{jobId}": {
      "delete": {
        "description": "Bricht einen Auftrag ab und entfernt seine Arbeitsdateien sofort, statt auf den regelmäßigen Aufräumlauf zu warten. Der Aufruf ist wiederholbar.",
        "operationId": "CancelJob",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Der Zugangsschlüssel fehlt oder ist ungültig."
          },
          "403": {
            "description": "Die Anfrage kam nicht von einer zugelassenen Adresse."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {}
        ],
        "summary": "Auftrag abbrechen",
        "tags": [
          "ChangeMyVoice"
        ]
      },
      "get": {
        "description": "Liefert den Zustand eines Auftrags. Steht das Ergebnis bereit, enthält die Antwort zusätzlich die Abrufadresse sowie Größe und Prüfsumme der Datei.",
        "operationId": "GetJobStatus",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Der Zugangsschlüssel fehlt oder ist ungültig."
          },
          "403": {
            "description": "Die Anfrage kam nicht von einer zugelassenen Adresse."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not Found"
          }
        },
        "security": [
          {}
        ],
        "summary": "Status abfragen",
        "tags": [
          "ChangeMyVoice"
        ]
      }
    },
    "/api/v1/jobs/{jobId}/result": {
      "get": {
        "description": "Liefert die konvertierte Aufnahme als WAV. Der Abruf ist wiederholbar; die Datei wird erst nach Ablauf der Aufbewahrungsfrist entfernt.",
        "operationId": "GetJobResult",
        "parameters": [
          {
            "in": "path",
            "name": "jobId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "audio/wav": {
                "schema": {
                  "$ref": "#/components/schemas/IResult"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Bad Request"
          },
          "401": {
            "description": "Der Zugangsschlüssel fehlt oder ist ungültig."
